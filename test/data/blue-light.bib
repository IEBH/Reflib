number={11},
pages={1027-32},
keywords={Acne Vulgaris/*therapy Humans Low-Level Light Therapy/*methods Photochemotherapy/*methods Photosensitizing Agents/*therapeutic use Practice Guidelines as Topic Practice Patterns, Physicians' Treatment Outcome},
abstract={In recent years, a number of studies have evaluated the treatment of acne using electromagnetic waves, such as lasers, photodynamic therapy, visible light or radio waves. While the efficacy of laser treatment is still uncertain, photodynamic therapy shows promising results, but with marked side-effects, as destruction of sebaceous glands. Treatment with blue light (405-420 nm wavelength) also appears effective and can be regarded as an treatment option for inflammatory acne.},
note={Borelli, C Merk, K Plewig, G Degitz, K English Abstract Journal Article Review Germany 2005/10/04 Hautarzt. 2005 Nov;56(11):1027-32. doi: 10.1007/s00105-005-1036-0.},
doi={10.1007/s00105-005-1036-0},
url={https://doi.org/10.1007/s00105-005-1036-0},
language={ger}
}

@Article{907,
